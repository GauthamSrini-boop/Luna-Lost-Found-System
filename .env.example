# Copy to .env (PowerShell: Copy-Item .env.example .env) and edit. Never commit .env.
NODE_ENV=development
PORT=3000
# SQLite file location (relative paths resolve from the project root)
DATABASE_PATH=server/data/luna.db
UPLOAD_DIR=server/uploads
# REQUIRED in production: 32+ random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
SESSION_TTL_HOURS=168
# Cookie "Secure" flag. Defaults to true when NODE_ENV=production (needs HTTPS).
COOKIE_SECURE=
MAX_UPLOAD_BYTES=2097152
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_MINUTES=15
# Set to 1 only when running behind a trusted reverse proxy (uses X-Forwarded-For for rate limiting)
TRUST_PROXY=0
